{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Auto MIDI Player (Tauri Desktop)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/scripts/dev.js",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Rust: Debug Native Core (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/src-tauri/target/debug/auto-midi-player.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/src-tauri",
      "console": "integratedTerminal"
    }
  ]
}
