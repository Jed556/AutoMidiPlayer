<UserControl x:Class="AutoMidiPlayer.WPF.Controls.PianoRoll.HorizontalPianoRoll"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AutoMidiPlayer.WPF.Controls.PianoRoll"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800"
             ClipToBounds="True"
             Background="{DynamicResource LayerFillColorDefaultBrush}">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <local:PianoRollCanvas x:Name="Canvas"
                               Grid.Column="0"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               ClipToBounds="True" />

        <!-- Vertical Scrollbar matching the App's native Fluent ScrollBar style -->
        <ScrollBar Grid.Column="1"
                   x:Name="VerticalScrollBar"
                   Orientation="Vertical"
                   Width="10"
                   Margin="2,0,2,0"
                   Minimum="0"
                   Value="0"
                   SmallChange="16"
                   LargeChange="64"
                   Visibility="Collapsed"
                   Scroll="OnVerticalScrollBarScroll">
            <ScrollBar.Style>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Margin" Value="2,0,2,0" />
                </Style>
            </ScrollBar.Style>
        </ScrollBar>
    </Grid>
</UserControl>
