<UserControl x:Class="AutoMidiPlayer.WPF.Controls.MarkerActionPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AutoMidiPlayer.WPF.Controls"
             x:Name="Root"
             Width="84">

    <UserControl.RenderTransformOrigin>
        <Point X="0.5" Y="1.0" />
    </UserControl.RenderTransformOrigin>
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="EntranceScale" ScaleX="1.0" ScaleY="1.0"/>
            <TranslateTransform x:Name="EntranceTranslate" Y="0"/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <!-- Transparent outer container to bridge the mouse hover path towards the marker without triggering MouseLeave -->
    <Border x:Name="OuterBorder" Width="84" HorizontalAlignment="Center" Padding="0,0,0,6" Background="Transparent">
        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Width="84"
                HorizontalAlignment="Center"
                Padding="8,8,8,8">
            <StackPanel HorizontalAlignment="Center">
                <!-- Marker Key Title -->
                <TextBlock x:Name="MarkerTitleText"
                           Text="C (+0)"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center"
                           MaxWidth="68"
                           TextTrimming="CharacterEllipsis" />

                <!-- Timestamp moved below title -->
                <TextBlock x:Name="MarkerTimeText"
                           Text="00:00.000"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Opacity="0.65"
                           HorizontalAlignment="Center"
                           Margin="0,1,0,6" />

                <!-- Action Buttons: Icon-only Delete on Left, Edit on Right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <controls:Button x:Name="DeleteButton"
                                     Variant="Ghost"
                                     ColorMode="Danger"
                                     Icon="Delete16"
                                     IconFilled="True"
                                     IconFontSize="13"
                                     Width="26"
                                     Height="26"
                                     Padding="0"
                                     Margin="0,0,4,0"
                                     Click="OnDeleteClick"
                                     ToolTip="Delete marker" />

                    <controls:Button x:Name="EditButton"
                                     Variant="Ghost"
                                     Icon="Edit16"
                                     IconFilled="True"
                                     IconFontSize="13"
                                     Width="26"
                                     Height="26"
                                     Padding="0"
                                     Margin="0,0,0,0"
                                     Click="OnEditClick"
                                     ToolTip="Edit marker" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
