{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto MIDI Player",
  "mainBinaryName": "Auto MIDI Player",
  "version": "8.0.0",
  "identifier": "com.jed556.automidiplayer",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm release:docs && pnpm build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Auto MIDI Player",
        "visible": false,
        "width": 1040,
        "height": 700,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#1f1f1f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/default.sf2",
      "resources/defaults/**/*",
      "resources/docs/*"
    ]
  }
}
