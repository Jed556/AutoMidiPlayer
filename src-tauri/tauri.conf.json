{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto MIDI Player",
  "mainBinaryName": "Auto MIDI Player",
  "version": "8.5.3",
  "identifier": "com.jed556.automidiplayer",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:15473",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm release:docs && pnpm build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Auto MIDI Player",
        "visible": false,
        "width": 1040,
        "height": 700,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#1f1f1f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost https://avatars.githubusercontent.com https://github.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.github.com https://raw.githubusercontent.com",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost https://avatars.githubusercontent.com https://github.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.github.com https://raw.githubusercontent.com ws:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/Jed556/AutoMIDIPlayer/Games/**/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/soundfonts/TimGM6mb.sf2",
      "resources/soundfonts/legacy.sf2",
      "resources/soundfonts/GeneralUser-GS.sf2",
      "resources/soundfonts/GeneralUser-GS-LICENSE.txt",
      "resources/defaults/**/*",
      "resources/docs/*"
    ]
  }
}
